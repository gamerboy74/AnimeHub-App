{
  "expo": {
    "name": "Animehub-Mobile",
    "slug": "Animehub-Mobile",
    "scheme": "animehubmobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080810"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dexstorm1.animehubmobile",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.dexstorm1.animehubmobile",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080810"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-video"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "aedd3dae-4b70-4538-8541-9d474411c508"
      }
    },
    "owner": "omkayuja"
  }
}